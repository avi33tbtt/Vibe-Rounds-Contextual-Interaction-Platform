{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viberounds.example/schemas/collection-task.schema.json",
  "title": "Collection Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "patient_ref",
    "requested_elements",
    "status",
    "created_at",
    "initiator"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "patient_ref": {
      "type": "object",
      "required": [
        "system",
        "id"
      ],
      "properties": {
        "system": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "encounter_ref": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "system": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pathway_ref": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "system": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "requested_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "system",
          "id"
        ],
        "properties": {
          "system": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "collection_specification_ref": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "initiator": {
      "type": "object",
      "required": [
        "actor_type",
        "actor_ref"
      ],
      "properties": {
        "actor_type": {
          "enum": [
            "patient",
            "practitioner",
            "staff",
            "system",
            "ai_agent"
          ]
        },
        "actor_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "recipient": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "actor_type": {
          "enum": [
            "patient",
            "caregiver",
            "practitioner",
            "staff"
          ]
        },
        "actor_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "permitted_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_required": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "enum": [
        "draft",
        "requested",
        "assigned",
        "in_progress",
        "responded",
        "validating",
        "submitted_for_review",
        "accepted",
        "rejected",
        "completed",
        "declined",
        "unable_to_answer",
        "expired",
        "cancelled",
        "failed"
      ]
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}